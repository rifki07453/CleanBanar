<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/margin_24">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/margin_24"
            android:paddingEnd="@dimen/margin_24"
            android:paddingTop="@dimen/margin_56"
            android:paddingBottom="@dimen/margin_24"
            android:gravity="center_vertical">
            
            <TextView
                android:id="@+id/tvStatsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Statistik"
                android:textStyle="bold"
                android:textSize="@dimen/text_24"
                android:textColor="@color/text_primary" />
                
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_1"
            android:background="#f1f3f5"
            android:layout_marginBottom="@dimen/margin_24" />

        <!-- Rata-rata Kapasitas Hari Ini -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RATA-RATA KAPASITAS HARI INI"
            android:textStyle="bold"
            android:textSize="@dimen/text_11"
            android:textColor="@color/text_secondary"
            android:textAlignment="center"
            android:layout_marginBottom="@dimen/margin_16" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_16">

            <!-- Organik Box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/margin_8"
                app:cardCornerRadius="@dimen/margin_16"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/green_600">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_20">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ORGANIK"
                        android:textSize="@dimen/text_10"
                        android:textStyle="bold"
                        android:textColor="@color/white" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/margin_8">
                        <TextView
                            android:id="@+id/tvOrganikAvg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="79"
                            android:textSize="@dimen/text_32"
                            android:textStyle="bold"
                            android:textColor="@color/white" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="%"
                            android:textSize="@dimen/text_14"
                            android:textColor="#B2FCDB"
                            android:layout_marginStart="@dimen/margin_4" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvOrganikTrend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Turun 2%"
                        android:textSize="@dimen/text_10"
                        android:textColor="#B2FCDB"
                        android:layout_marginTop="@dimen/margin_8" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Non-Organik Box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/margin_8"
                app:cardCornerRadius="@dimen/margin_16"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/blue_500">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_20">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NON-ORG"
                        android:textSize="@dimen/text_10"
                        android:textStyle="bold"
                        android:textColor="@color/white" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/margin_8">
                        <TextView
                            android:id="@+id/tvNonOrganikAvg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="63"
                            android:textSize="@dimen/text_32"
                            android:textStyle="bold"
                            android:textColor="@color/white" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="%"
                            android:textSize="@dimen/text_14"
                            android:textColor="#BFDBFE"
                            android:layout_marginStart="@dimen/margin_4" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvNonOrganikTrend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Naik 37%"
                        android:textSize="@dimen/text_10"
                        android:textColor="#BFDBFE"
                        android:layout_marginTop="@dimen/margin_8" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Container Card 2: RATA RATA MINGGUAN -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_24"
            app:cardCornerRadius="@dimen/margin_20"
            app:cardElevation="0dp"
            app:strokeColor="#f1f3f5"
            app:strokeWidth="@dimen/margin_1"
            app:cardBackgroundColor="@color/bg_card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/margin_24"
                android:baselineAligned="false">
                
                <!-- RATA-RATA MINGGUAN -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RATA-RATA\nMINGGUAN"
                        android:textSize="@dimen/text_10"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvWeeklyAvg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="39.8%"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_22"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/margin_12" />
                </LinearLayout>

                <!-- Separator Line -->
                <View
                    android:layout_width="@dimen/margin_1"
                    android:layout_height="match_parent"
                    android:background="#f1f3f5"
                    android:layout_marginHorizontal="@dimen/margin_16" />

                <!-- TOTAL PENUH (MINGGU INI) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL PENUH (MINGGU INI)"
                        android:textSize="@dimen/text_10"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end|bottom"
                        android:layout_marginTop="@dimen/margin_12">
                        <TextView
                            android:id="@+id/tvTotalPenuh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_24"
                            android:textColor="@color/red_500" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" kali"
                            android:textSize="@dimen/text_12"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="@dimen/margin_4" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Grafik Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_16"
            app:cardCornerRadius="@dimen/margin_20"
            app:cardElevation="0dp"
            app:strokeColor="#f1f3f5"
            app:strokeWidth="@dimen/margin_1"
            app:cardBackgroundColor="@color/bg_card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_20">

                <!-- Header Grafik dengan Toggle Mode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/margin_16">
                    
                    <TextView
                        android:id="@+id/tvChartTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Grafik Kapasitas"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/text_primary" />

                    <Spinner
                        android:id="@+id/spinnerChartMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:spinnerMode="dropdown" />
                </LinearLayout>

                <!-- Chart & Y-Axis Area -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Sumbu Y -->
                    <LinearLayout
                        android:id="@+id/yAxisContainer"
                        android:layout_width="@dimen/margin_28"
                        android:layout_height="@dimen/margin_140"
                        android:orientation="vertical"
                        android:gravity="end"
                        android:paddingEnd="@dimen/margin_6" />

                    <!-- Chart Container -->
                    <LinearLayout
                        android:id="@+id/chartContainer"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_140"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:baselineAligned="false" />
                </LinearLayout>

                <!-- Legend -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/margin_16">
                    <View
                        android:layout_width="@dimen/margin_8"
                        android:layout_height="@dimen/margin_8"
                        android:background="@drawable/ic_bg_circle_green"
                        android:layout_gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvLegendOrganik"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Organik (%)   "
                        android:textSize="@dimen/text_11"
                        android:textColor="@color/text_primary" />
                    <View
                        android:layout_width="@dimen/margin_8"
                        android:layout_height="@dimen/margin_8"
                        android:background="@drawable/ic_bg_circle_blue"
                        android:layout_gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvLegendNonOrganik"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Non-Organik (%)"
                        android:textSize="@dimen/text_11"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Perbandingan & Tren Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_20"
            app:cardCornerRadius="@dimen/margin_20"
            app:cardElevation="0dp"
            app:strokeColor="#f1f3f5"
            app:strokeWidth="@dimen/margin_1"
            app:cardBackgroundColor="@color/bg_card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_20">

                <!-- Header Perbandingan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/margin_16">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tren &amp; Perbandingan"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/text_primary" />

                    <!-- Spinner Period -->
                    <Spinner
                        android:id="@+id/spinnerComparePeriod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:spinnerMode="dropdown" />
                </LinearLayout>

                <!-- Comparison Content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Organik Compare -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ORGANIK"
                            android:textSize="@dimen/text_10"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary" />
                        
                        <TextView
                            android:id="@+id/tvCompareOrganikValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="@dimen/text_20"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginTop="@dimen/margin_8" />
                        
                        <TextView
                            android:id="@+id/tvCompareOrganikTrend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tidak ada data pembanding"
                            android:textSize="@dimen/text_10"
                            android:textColor="@color/text_tertiary"
                            android:layout_marginTop="@dimen/margin_4" />
                    </LinearLayout>

                    <!-- Separator Line -->
                    <View
                        android:layout_width="@dimen/margin_1"
                        android:layout_height="match_parent"
                        android:background="#f1f3f5"
                        android:layout_marginHorizontal="@dimen/margin_16" />

                    <!-- Non-Organik Compare -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NON-ORGANIK"
                            android:textSize="@dimen/text_10"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary" />
                        
                        <TextView
                            android:id="@+id/tvCompareNonOrganikValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="@dimen/text_20"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginTop="@dimen/margin_8" />
                        
                        <TextView
                            android:id="@+id/tvCompareNonOrganikTrend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tidak ada data pembanding"
                            android:textSize="@dimen/text_10"
                            android:textColor="@color/text_tertiary"
                            android:layout_marginTop="@dimen/margin_4" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
