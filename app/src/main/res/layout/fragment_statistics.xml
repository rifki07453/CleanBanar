<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="24dp"
            android:gravity="center_vertical">
            
            <TextView
                android:id="@+id/tvStatsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Statistik"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="@color/gray_900" />
                
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#f1f3f5"
            android:layout_marginBottom="24dp" />

        <!-- Rata-rata Kapasitas Hari Ini -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RATA-RATA KAPASITAS HARI INI"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="@color/gray_600"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp">

            <!-- Organik Box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/emerald_500">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ORGANIK"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/white" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:id="@+id/tvOrganikAvg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="79"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="%"
                            android:textSize="14sp"
                            android:textColor="#B2FCDB"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvOrganikTrend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Turun 2%"
                        android:textSize="10sp"
                        android:textColor="#B2FCDB"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Non-Organik Box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/blue_500">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NON-ORG"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/white" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:id="@+id/tvNonOrganikAvg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="63"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="%"
                            android:textSize="14sp"
                            android:textColor="#BFDBFE"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvNonOrganikTrend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Naik 37%"
                        android:textSize="10sp"
                        android:textColor="#BFDBFE"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Container Card 2: RATA RATA MINGGUAN -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#f1f3f5"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="24dp"
                android:baselineAligned="false">
                
                <!-- RATA-RATA MINGGUAN -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RATA-RATA\nMINGGUAN"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_600" />
                    <TextView
                        android:id="@+id/tvWeeklyAvg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="39.8%"
                        android:textStyle="bold"
                        android:textSize="22sp"
                        android:textColor="@color/gray_900"
                        android:layout_marginTop="12dp" />
                </LinearLayout>

                <!-- Separator Line -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#f1f3f5"
                    android:layout_marginHorizontal="16dp" />

                <!-- TOTAL PENUH (MINGGU INI) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL PENUH (MINGGU INI)"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_600" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end|bottom"
                        android:layout_marginTop="12dp">
                        <TextView
                            android:id="@+id/tvTotalPenuh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4"
                            android:textStyle="bold"
                            android:textSize="24sp"
                            android:textColor="@color/red_500" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" kali"
                            android:textSize="12sp"
                            android:textColor="@color/gray_500"
                            android:layout_marginBottom="4dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Da Grafik Kapasitas (7 Hari) Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#f1f3f5"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grafik Kapasitas (7 Hari)"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/gray_900"
                    android:layout_marginBottom="16dp" />

                <!-- Chart area placeholder / built programmatically -->
                <LinearLayout
                    android:id="@+id/chartContainer"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:baselineAligned="false" />

                <!-- Legend -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp">
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/ic_bg_circle_green"
                        android:layout_gravity="center_vertical" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Organik(%)   "
                        android:textSize="11sp"
                        android:textColor="@color/gray_700" />
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/ic_bg_circle_blue"
                        android:layout_gravity="center_vertical" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Non-Organik(%)"
                        android:textSize="11sp"
                        android:textColor="@color/gray_700" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
