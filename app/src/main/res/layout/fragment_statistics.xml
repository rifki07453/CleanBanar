<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_50">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Statistik"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="@color/gray_900" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tren pengisian tong sampah"
                android:textSize="13sp"
                android:textColor="@color/gray_500"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Comparison Card: Organik vs Non-Organik Average -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rata-rata Kapasitas (7 hari)"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/gray_800"
                    android:layout_marginBottom="16dp" />

                <!-- Organik Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Organik"
                            android:textSize="12sp"
                            android:textColor="@color/gray_500" />
                        <TextView
                            android:id="@+id/tvOrganikAvg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/emerald_600"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:background="@drawable/edit_text_bg">
                        <View
                            android:id="@+id/barOrganik"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/progress_bar_green" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Non-Organik Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Non-Organik"
                            android:textSize="12sp"
                            android:textColor="@color/gray_500" />
                        <TextView
                            android:id="@+id/tvNonOrganikAvg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/secondary"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:background="@drawable/edit_text_bg">
                        <View
                            android:id="@+id/barNonOrganik"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/progress_bar_amber" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Daily Trend Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tren Harian (7 hari terakhir)"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/gray_800"
                    android:layout_marginBottom="4dp" />

                <!-- Legend -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/emerald_600"
                        android:layout_gravity="center_vertical" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Organik   "
                        android:textSize="10sp"
                        android:textColor="@color/gray_500" />
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/secondary"
                        android:layout_gravity="center_vertical" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Non-Organik"
                        android:textSize="10sp"
                        android:textColor="@color/gray_500" />
                </LinearLayout>

                <!-- Chart area (vertical bars built programmatically) -->
                <LinearLayout
                    android:id="@+id/chartContainer"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:baselineAligned="false" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
