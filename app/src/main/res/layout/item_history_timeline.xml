<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/margin_16"
    android:paddingEnd="@dimen/margin_16">

    <!-- Timeline Column (Straight Gray Line) -->
    <View
        android:id="@+id/timelineLine"
        android:layout_width="@dimen/margin_2"
        android:layout_height="0dp"
        android:background="#F3F4F6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="@dimen/margin_14" />

    <!-- Timeline Dot with White Ring Overlapping the Line -->
    <View
        android:id="@+id/timelineDot"
        android:layout_width="@dimen/margin_16"
        android:layout_height="@dimen/margin_16"
        android:background="@drawable/dot_timeline_green"
        app:layout_constraintBottom_toBottomOf="@id/topGuideline"
        app:layout_constraintEnd_toEndOf="@id/timelineLine"
        app:layout_constraintStart_toStartOf="@id/timelineLine"
        app:layout_constraintTop_toTopOf="@id/topGuideline" />

    <!-- Guideline to vertically align the dot and card content top -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="@dimen/margin_32" />

    <!-- Timeline Card (Detail) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/historyCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_24"
        android:layout_marginTop="@dimen/margin_8"
        android:layout_marginBottom="@dimen/margin_16"
        app:cardCornerRadius="@dimen/margin_16"
        app:cardElevation="@dimen/margin_1"
        app:strokeWidth="@dimen/margin_1"
        app:strokeColor="#F3F4F6"
        app:cardBackgroundColor="@color/bg_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/timelineLine"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_16">

            <!-- Row 1: Header Card (Badge & Time) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_green"
                    android:paddingHorizontal="@dimen/margin_10"
                    android:paddingVertical="@dimen/margin_4"
                    android:text="DIKOSONGKAN"
                    android:textColor="#059669" 
                    android:textSize="@dimen/text_10"
                    android:textStyle="bold" />

                <!-- Flexible space between badge and time -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:12 AM"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_11"
                    android:typeface="monospace" />
            </LinearLayout>

            <!-- Row 2: Judul -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_12"
                android:text="Sampah Organik"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_14"
                android:textStyle="bold" />

            <!-- Row 3: Deskripsi -->
            <TextView
                android:id="@+id/tvDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4"
                android:lineSpacingExtra="@dimen/margin_2"
                android:text="Notifikasi dikirim ke petugas kebersihan untuk pengangkutan."
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_12" />

            <!-- Row 4: Footer Divider & Date -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_1"
                android:background="#F3F4F6"
                android:layout_marginTop="@dimen/margin_16"
                android:layout_marginBottom="@dimen/margin_12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/margin_14"
                    android:layout_height="@dimen/margin_14"
                    android:src="@android:drawable/ic_menu_today"
                    app:tint="@color/text_tertiary" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_6"
                    android:text="Hari ini, 24 Mart"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_11" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
