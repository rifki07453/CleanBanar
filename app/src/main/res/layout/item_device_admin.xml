<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_12"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/margin_16"
    app:cardElevation="@dimen/margin_1"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="@dimen/margin_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/margin_16">

        <FrameLayout
            android:layout_width="@dimen/margin_48"
            android:layout_height="@dimen/margin_48"
            android:background="@drawable/bg_rounded_light_blue"
            android:backgroundTint="#F3F4F6">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/margin_12"
                android:src="@drawable/ic_iot_device_modern" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Perangkat"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_14"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2"
                android:text="ID: device_xyz"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_12" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/margin_8"
            android:paddingVertical="@dimen/margin_4">

            <View
                android:id="@+id/dotStatus"
                android:layout_width="@dimen/margin_6"
                android:layout_height="@dimen/margin_6"
                android:layout_marginEnd="@dimen/margin_4"
                android:background="@drawable/dot_timeline_green" />

            <TextView
                android:id="@+id/tvDeviceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONLINE"
                android:textColor="#059669"
                android:textSize="@dimen/text_9"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
