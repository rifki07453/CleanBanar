<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_light_blue"
    android:backgroundTint="@color/bg_card">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margin_24">

        <!-- Drag Handle -->
        <View
            android:layout_width="@dimen/margin_40"
            android:layout_height="@dimen/margin_4"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/margin_24"
            android:background="#E5E7EB" />

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/margin_24">

            <FrameLayout
                android:id="@+id/flConnectionIconBg"
                android:layout_width="@dimen/margin_56"
                android:layout_height="@dimen/margin_56"
                android:background="@drawable/bg_circle_glass"
                android:backgroundTint="#D1FAE5">
                <ImageView
                    android:id="@+id/ivConnectionIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/margin_14"
                    android:src="@drawable/ic_wifi_status" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/margin_16">

                <TextView
                    android:id="@+id/tvDetailDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Perangkat"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_18"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ONLINE (WiFi)"
                    android:textColor="#059669"
                    android:textSize="@dimen/text_12"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/margin_2" />
            </LinearLayout>
            
            <ImageView
                android:id="@+id/btnDeleteDevice"
                android:layout_width="@dimen/margin_32"
                android:layout_height="@dimen/margin_32"
                android:src="@drawable/ic_trash_modern"
                app:tint="#DC2626"
                android:padding="@dimen/margin_4"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_1"
            android:background="#F3F4F6"
            android:layout_marginBottom="@dimen/margin_16" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Overview"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary"
            app:cornerRadius="8dp"
            android:layout_marginBottom="@dimen/margin_24" />

        <!-- QR Code Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/margin_24">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR CODE PERANGKAT"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_10"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/margin_12" />

            <ImageView
                android:id="@+id/ivDeviceQrCode"
                android:layout_width="@dimen/margin_150"
                android:layout_height="@dimen/margin_150"
                android:scaleType="fitCenter" />
                
            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_12"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/margin_8" />
                
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrintQr"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cetak / Simpan PDF"
                android:textColor="#3B82F6"
                app:icon="@drawable/ic_scan_qr"
                app:iconTint="#3B82F6"
                android:layout_marginTop="@dimen/margin_12" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_1"
            android:background="#F3F4F6"
            android:layout_marginBottom="@dimen/margin_24" />

        <!-- Edit PIN Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KONFIGURASI PIN SENSOR (DINAMIS)"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_10"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/margin_12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/margin_8"
                android:layout_marginBottom="@dimen/margin_12"
                android:hint="Tinggi Tong (cm)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDetailTinggiTong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/margin_8"
                android:layout_marginBottom="@dimen/margin_12"
                android:hint="Batas Penuh (cm)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDetailBatasPenuh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_12"
            android:hint="Jarak Tangan (cm)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDetailBatasJarakTangan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            
            <!-- Organik -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="@dimen/margin_8">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Organik"
                    android:textSize="@dimen/text_12"
                    android:textColor="#16A34A"
                    android:layout_marginBottom="@dimen/margin_4" />
                    
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_8"
                    android:hint="Sensor Penuh (Trig)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDetailTrigOrg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
                
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_8"
                    android:hint="Sensor Penuh (Echo)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDetailEchoOrg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_8"
                    android:hint="Sensor Tangan (Trig)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDetailTrigLuarOrg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_8"
                    android:hint="Sensor Tangan (Echo)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDetailEchoLuarOrg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Motor Servo Buka">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDetailServoOrg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            
            <!-- Non-Organik -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/margin_8">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Non-Organik"
                    android:textSize="@dimen/text_12"
                    android:textColor="#2563EB"
                    android:layout_marginBottom="@dimen/margin_4" />
                    
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_8"
                    android:hint="Sensor Penuh (Trig)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDetailTrigNonOrg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
                
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_8"
                    android:hint="Sensor Penuh (Echo)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDetailEchoNonOrg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_8"
                    android:hint="Sensor Tangan (Trig)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDetailTrigLuarNonOrg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_8"
                    android:hint="Sensor Tangan (Echo)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDetailEchoLuarNonOrg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Motor Servo Buka">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDetailServoNonOrg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdatePins"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Konfigurasi Pin"
            android:textColor="#10B981"
            app:strokeColor="#10B981"
            android:layout_marginTop="@dimen/margin_8" />

        <!-- SERVO DEGREE SECTION -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_1"
            android:background="#F3F4F6"
            android:layout_marginVertical="@dimen/margin_20" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KONFIGURASI DERAJAT SERVO"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_10"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/margin_4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atur terpisah agar kompatibel dengan berbagai jenis servo (0°–360°)"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_10"
            android:layout_marginBottom="@dimen/margin_12" />

        <!-- Organik Servo Degrees -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F0FDF4"
            android:padding="@dimen/margin_12"
            android:layout_marginBottom="@dimen/margin_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢  Servo Organik"
                android:textColor="#16A34A"
                android:textSize="@dimen/text_12"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/margin_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/margin_8"
                    android:hint="Derajat Buka (°)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etServoDerajatBukaOrg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_8"
                    android:hint="Derajat Tutup (°)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etServoDerajatTutupOrg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Non-Organik Servo Degrees -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#EFF6FF"
            android:padding="@dimen/margin_12"
            android:layout_marginBottom="@dimen/margin_12">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔵  Servo Non-Organik"
                android:textColor="#2563EB"
                android:textSize="@dimen/text_12"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/margin_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/margin_8"
                    android:hint="Derajat Buka (°)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etServoDerajatBukaNon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_8"
                    android:hint="Derajat Tutup (°)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etServoDerajatTutupNon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateServoDerajat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Derajat Servo"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:backgroundTint="#7C3AED"
            app:cornerRadius="@dimen/margin_8"
            app:icon="@drawable/ic_refresh_24dp"
            app:iconTint="@color/white" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_1"
            android:background="#F3F4F6"
            android:layout_marginVertical="@dimen/margin_24" />

        <!-- Provisioning Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WIFI PROVISIONING (BLUETOOTH)"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_10"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/margin_12" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama WiFi (SSID)"
            app:boxCornerRadiusBottomEnd="@dimen/margin_12"
            app:boxCornerRadiusBottomStart="@dimen/margin_12"
            app:boxCornerRadiusTopEnd="@dimen/margin_12"
            app:boxCornerRadiusTopStart="@dimen/margin_12"
            android:layout_marginBottom="@dimen/margin_12"
            app:endIconMode="dropdown_menu">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etSsid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Sandi WiFi"
            app:boxCornerRadiusBottomEnd="@dimen/margin_12"
            app:boxCornerRadiusBottomStart="@dimen/margin_12"
            app:boxCornerRadiusTopEnd="@dimen/margin_12"
            app:boxCornerRadiusTopStart="@dimen/margin_12"
            android:layout_marginBottom="@dimen/margin_16"
            app:passwordToggleEnabled="true">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendConfig"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_56"
            android:text="Kirim via Bluetooth"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:cornerRadius="@dimen/margin_12"
            app:backgroundTint="#3B82F6" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
