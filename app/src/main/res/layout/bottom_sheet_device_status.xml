<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_light_blue"
    android:backgroundTint="@color/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/margin_24">

    <!-- Drag Handle -->
    <View
        android:layout_width="@dimen/margin_40"
        android:layout_height="@dimen/margin_4"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/margin_24"
        android:background="#E5E7EB" />

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/margin_24">

        <FrameLayout
            android:id="@+id/flConnectionIconBg"
            android:layout_width="@dimen/margin_56"
            android:layout_height="@dimen/margin_56"
            android:background="@drawable/bg_circle_glass"
            android:backgroundTint="#D1FAE5">
            <ImageView
                android:id="@+id/ivConnectionIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/margin_14"
                android:src="@drawable/ic_wifi_status" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/margin_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status Koneksi Alat"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_12" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONLINE (WiFi)"
                android:textColor="#059669"
                android:textSize="@dimen/text_20"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/margin_2" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_1"
        android:background="#F3F4F6"
        android:layout_marginBottom="@dimen/margin_24" />

    <!-- Details Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INFORMASI PERANGKAT"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_10"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/margin_12" />

    <!-- Detail 1: Mode Saat Ini -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/margin_16">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mode Jaringan"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_14" />
        <TextView
            android:id="@+id/tvNetworkMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terhubung via WiFi"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_14"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Detail 2: Sinkronisasi Terakhir -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/margin_16">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Terakhir Terhubung"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_14" />
        <TextView
            android:id="@+id/tvLastSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Baru saja"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_14"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_1"
        android:background="#F3F4F6"
        android:layout_marginVertical="@dimen/margin_8" />

    <!-- Toggle Buttons Area -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GANTI MODE KONEKSI"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_10"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/margin_16"
        android:layout_marginBottom="@dimen/margin_12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">
        
        <!-- Button WiFi -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnModeWifi"
            android:layout_width="0dp"
            android:layout_height="@dimen/margin_48"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/margin_8"
            app:cardCornerRadius="@dimen/margin_12"
            app:cardElevation="0dp"
            app:strokeWidth="@dimen/margin_2"
            app:strokeColor="#10B981"
            app:cardBackgroundColor="#ECFDF5"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="@dimen/margin_16"
                    android:layout_height="@dimen/margin_16"
                    android:src="@drawable/ic_wifi_status"
                    app:tint="#059669" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Via WiFi"
                    android:textColor="#059669"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_14"
                    android:layout_marginStart="@dimen/margin_8" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Button Bluetooth -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnModeBluetooth"
            android:layout_width="0dp"
            android:layout_height="@dimen/margin_48"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_8"
            app:cardCornerRadius="@dimen/margin_12"
            app:cardElevation="0dp"
            app:strokeWidth="@dimen/margin_1"
            app:strokeColor="#E5E7EB"
            app:cardBackgroundColor="@color/bg_card"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="@dimen/margin_16"
                    android:layout_height="@dimen/margin_16"
                    android:src="@drawable/ic_bluetooth_status"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Via Bluetooth"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_14"
                    android:layout_marginStart="@dimen/margin_8" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Provisioning Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PENGATURAN WIFI (PROVISIONING)"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_10"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/margin_24"
        android:layout_marginBottom="@dimen/margin_12" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nama WiFi (SSID)"
        app:boxCornerRadiusBottomEnd="@dimen/margin_12"
        app:boxCornerRadiusBottomStart="@dimen/margin_12"
        app:boxCornerRadiusTopEnd="@dimen/margin_12"
        app:boxCornerRadiusTopStart="@dimen/margin_12"
        android:layout_marginBottom="@dimen/margin_12">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSsid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Sandi WiFi"
        app:boxCornerRadiusBottomEnd="@dimen/margin_12"
        app:boxCornerRadiusBottomStart="@dimen/margin_12"
        app:boxCornerRadiusTopEnd="@dimen/margin_12"
        app:boxCornerRadiusTopStart="@dimen/margin_12"
        android:layout_marginBottom="@dimen/margin_16"
        app:passwordToggleEnabled="true">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendConfig"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_56"
        android:text="Kirim Konfigurasi ke ESP32"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:cornerRadius="@dimen/margin_12"
        app:backgroundTint="#3B82F6" />

</LinearLayout>
