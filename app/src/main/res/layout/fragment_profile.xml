<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_50">

    <!-- Header Gradient Background -->
    <FrameLayout
        android:id="@+id/headerBlockProfile"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/header_gradient_bg"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- User Profile Info in Header -->
    <ImageView
        android:id="@+id/ivUserAvatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/ic_bg_circle_green_transparent"
        android:src="@android:drawable/ic_menu_myplaces"
        app:tint="@color/white"
        android:padding="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toEndOf="@id/ivUserAvatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivUserAvatar"
        app:layout_constraintBottom_toBottomOf="@id/ivUserAvatar">

        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Petugas CleanBanar"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="petugas@cleanbanar.com"
            android:textColor="@color/emerald_100"
            android:textSize="13sp" />
        
        <!-- Role acts as hidden or minimal info now -->
        <TextView
            android:id="@+id/tvProfileRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-40dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/ivUserAvatar"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- The White Menu Card overlapping the header -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="16dp">

                <!-- Menu Item: Edit Profil -->
                <LinearLayout
                    android:id="@+id/btnEditProfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/ic_bg_circle_blue"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="@color/blue_500"
                        android:padding="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="Edit Profil"
                        android:textColor="@color/gray_800"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Menu Item: Pengaturan Notifikasi -->
                <LinearLayout
                    android:id="@+id/btnNavNotifikasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/ic_bg_circle_purple"
                        android:src="@android:drawable/ic_popup_reminder"
                        app:tint="@color/purple_500"
                        android:padding="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="Pengaturan Notifikasi"
                        android:textColor="@color/gray_800"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                        
                    <ImageView
                        android:id="@+id/ivExpandNotif"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/arrow_down_float"
                        app:tint="@color/gray_400" />
                </LinearLayout>

                <!-- Expandable Toggles Section -->
                <LinearLayout
                    android:id="@+id/expandableNotifSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:background="@color/gray_50"
                    android:visibility="gone">
                    <!-- Toggle 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sampah Hampir Penuh"
                            android:textSize="13sp"
                            android:textColor="@color/gray_800" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchHampirPenuh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:trackTint="@color/emerald_600" />
                    </LinearLayout>
                    <!-- Toggle 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sampah Penuh"
                            android:textSize="13sp"
                            android:textColor="@color/gray_800" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchPenuh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:trackTint="@color/emerald_600" />
                    </LinearLayout>
                    <!-- Toggle 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Selesai Dikosongkan"
                            android:textSize="13sp"
                            android:textColor="@color/gray_800" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchSelesai"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:trackTint="@color/emerald_600" />
                    </LinearLayout>
                    <!-- Toggle 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Notifikasi Sistem"
                            android:textSize="13sp"
                            android:textColor="@color/gray_800" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchSistem"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:trackTint="@color/emerald_600" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Menu Item: Keamanan & Password -->
                <LinearLayout
                    android:id="@+id/btnChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/ic_bg_circle_orange"
                        android:src="@android:drawable/ic_lock_idle_lock"
                        app:tint="@color/orange_600"
                        android:padding="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="Keamanan &amp; Password"
                        android:textColor="@color/gray_800"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_100"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginVertical="8dp" />

                <!-- Menu Item: Keluar Akun -->
                <LinearLayout
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/ic_bg_circle_red"
                        android:src="@android:drawable/ic_lock_power_off"
                        app:tint="@color/red_500"
                        android:padding="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="Keluar Akun"
                        android:textColor="@color/red_500"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
