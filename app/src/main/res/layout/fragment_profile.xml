<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"> <!-- Very light gray background -->

    <!-- Header Gradient Background -->
    <FrameLayout
        android:id="@+id/headerBlockProfile"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_200"
        android:background="@drawable/header_gradient_bg"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- User Profile Info in Header (Centered Vertically and Horizontally in Header) -->
    <LinearLayout
        android:id="@+id/llHeaderContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/margin_32"
        app:layout_constraintTop_toTopOf="@id/headerBlockProfile"
        app:layout_constraintBottom_toBottomOf="@id/headerBlockProfile"
        app:layout_constraintVertical_bias="0.4"> <!-- Slightly above center due to rounded corners -->

        <RelativeLayout
            android:layout_width="@dimen/margin_64"
            android:layout_height="@dimen/margin_64">
            
            <!-- Avatar Background: glassmorphism style (white 20% alpha) -->
            <FrameLayout
                android:id="@+id/flAvatarContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_glass"
                android:padding="@dimen/margin_2">
                
                <ImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/white"
                    android:padding="@dimen/margin_12"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <!-- Edit Icon Badge -->
            <FrameLayout
                android:id="@+id/flEditPhoto"
                android:layout_width="@dimen/margin_20"
                android:layout_height="@dimen/margin_20"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_circle_white"
                android:padding="@dimen/margin_3"
                android:elevation="@dimen/margin_2"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#3B82F6" />
            </FrameLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/margin_16">

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Pengguna"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="@dimen/text_20" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="email@contoh.com"
                android:textColor="#A7F3D0" 
                android:textSize="@dimen/text_14" />

            <TextView
                android:id="@+id/tvProfilePhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08123456789"
                android:textColor="#D1FAE5" 
                android:textSize="@dimen/text_12"
                android:layout_marginTop="@dimen/margin_2"
                android:visibility="gone" />
            
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerBlockProfile"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="@dimen/margin_minus_48"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/margin_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- The White Menu Card overlapping the header -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_24"
                app:cardCornerRadius="@dimen/margin_24"
                app:cardElevation="0dp"
                app:strokeWidth="@dimen/margin_1"
                app:strokeColor="#f1f3f5"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/margin_8">

                    <!-- Menu Item: Edit Profil -->
                    <LinearLayout
                        android:id="@+id/btnEditProfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/margin_16"
                        android:paddingVertical="@dimen/margin_12"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/margin_40"
                            android:layout_height="@dimen/margin_40"
                            android:background="@drawable/bg_rounded_light_blue"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="#3B82F6"
                            android:padding="@dimen/margin_8" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_16"
                            android:text="Edit Profil"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_14"
                            android:textStyle="bold" />
                            
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_1"
                        android:background="#F3F4F6" />

                    <!-- Menu Item: Pengaturan Notifikasi -->
                    <LinearLayout
                        android:id="@+id/btnNavNotifikasi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/margin_16"
                        android:paddingVertical="@dimen/margin_12"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/margin_40"
                            android:layout_height="@dimen/margin_40"
                            android:background="@drawable/bg_rounded_light_purple"
                            android:src="@android:drawable/ic_popup_reminder"
                            app:tint="#8B5CF6"
                            android:padding="@dimen/margin_8" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_16"
                            android:text="Pengaturan Notifikasi"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_14"
                            android:textStyle="bold" />
                            
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_1"
                        android:background="#F3F4F6" />

                    <!-- Menu Item: Keamanan & Password -->
                    <LinearLayout
                        android:id="@+id/btnChangePassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/margin_16"
                        android:paddingVertical="@dimen/margin_12"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/margin_40"
                            android:layout_height="@dimen/margin_40"
                            android:background="@drawable/bg_rounded_light_orange"
                            android:src="@android:drawable/ic_lock_idle_lock"
                            app:tint="#F97316"
                            android:padding="@dimen/margin_8" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_16"
                            android:text="Keamanan &amp; Password"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_14"
                            android:textStyle="bold" />
                            
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CardView Keluar Akun -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_24"
                android:layout_marginTop="@dimen/margin_16"
                android:layout_marginBottom="@dimen/margin_16"
                app:cardCornerRadius="@dimen/margin_24"
                app:cardElevation="0dp"
                app:strokeWidth="@dimen/margin_1"
                app:strokeColor="#f1f3f5"
                app:cardBackgroundColor="@color/bg_card">

                <!-- Menu Item: Keluar Akun -->
                <LinearLayout
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/margin_16"
                    android:paddingVertical="@dimen/margin_12"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/margin_40"
                        android:layout_height="@dimen/margin_40"
                        android:background="@drawable/bg_rounded_light_red"
                        android:src="@drawable/ic_logout"
                        app:tint="#EF4444"
                        android:padding="@dimen/margin_8" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_16"
                        android:text="Keluar Akun"
                        android:textColor="#EF4444"
                        android:textSize="@dimen/text_14"
                        android:textStyle="bold" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
