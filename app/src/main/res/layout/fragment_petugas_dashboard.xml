<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_50"
    tools:context=".features.dashboard.PetugasDashboardFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Header Gradient Block -->
        <FrameLayout
            android:id="@+id/headerBlock"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/header_gradient_bg"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivLogoStaff"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@mipmap/ic_logo_cleanbanar"
            android:scaleType="fitCenter"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="CleanBanar" />

        <TextView
            android:id="@+id/tvOverviewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MONITORING AREA"
            android:textColor="@color/emerald_100"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAreaName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Area Kampus A"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="64dp"
            app:layout_constraintStart_toStartOf="@id/tvOverviewTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOverviewTitle" />

        <TextView
            android:id="@+id/tvSubArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Halaman Belakang"
            android:textColor="@color/emerald_100"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@id/tvAreaName"
            app:layout_constraintTop_toBottomOf="@id/tvAreaName" />

        <TextView
            android:id="@+id/tvStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status Sistem Keseluruhan"
            android:textColor="@color/emerald_100"
            android:textSize="12sp"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="@id/tvAreaName"
            app:layout_constraintTop_toBottomOf="@id/tvSubArea" />

        <!-- Status indicator dot -->
        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/badge_green_bg"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@id/tvStatusLabel"
            app:layout_constraintTop_toBottomOf="@id/tvStatusLabel" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Normal"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@id/statusDot"
            app:layout_constraintTop_toTopOf="@id/statusDot"
            app:layout_constraintBottom_toBottomOf="@id/statusDot" />

        <!-- Cards Layout Container - dynamically populated -->
        <LinearLayout
            android:id="@+id/cardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="-20dp"
            app:layout_constraintTop_toBottomOf="@id/headerBlock" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
