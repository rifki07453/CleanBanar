<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_50"
    tools:context=".features.dashboard.PetugasDashboardFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="48dp">

        <!-- Header Gradient Block -->
        <FrameLayout
            android:id="@+id/headerBlock"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/header_gradient_bg"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvOverviewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MONITORING AREA"
            android:textColor="@color/emerald_100"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAreaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Area Kampus A"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvOverviewTitle"
            app:layout_constraintTop_toBottomOf="@id/tvOverviewTitle" />

        <TextView
            android:id="@+id/tvStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status Sistem"
            android:textColor="@color/emerald_100"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@id/tvAreaTitle"
            app:layout_constraintTop_toBottomOf="@id/tvAreaTitle" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Normal"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvStatusTitle"
            app:layout_constraintTop_toBottomOf="@id/tvStatusTitle" />

        <!-- Cards Layout Container -->
        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="-30dp"
            app:layout_constraintTop_toBottomOf="@id/headerBlock">

            <!-- Card Organik -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">
                        
                        <ImageView
                            android:id="@+id/icOrganik"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@android:drawable/ic_dialog_map"
                            android:background="@drawable/leaf_bg"
                            app:tint="@color/emerald_600"
                            android:padding="12dp"
                            android:layout_centerVertical="true"
                            android:contentDescription="Organik" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toEndOf="@id/icOrganik"
                            android:layout_marginStart="16dp"
                            android:layout_centerVertical="true">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Organik"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:textColor="@color/gray_800" />
                            <TextView
                                android:id="@+id/tvOrganikUpdate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Update 2 min lalu"
                                android:textSize="10sp"
                                android:textColor="@color/gray_400"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvOrganikBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TERSEDIA"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/green_600"
                            android:background="@drawable/badge_green_bg"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>

                    <!-- Progress Bar -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tingkat Kapasitas"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/gray_500" />
                        <TextView
                            android:id="@+id/tvOrganikPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="45%"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="@color/gray_800"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                    <ProgressBar
                        android:id="@+id/progressOrganik"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:progress="45"
                        android:progressDrawable="@drawable/progress_bar_green"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvOrganikStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dalam kondisi baik"
                        android:textAlignment="viewEnd"
                        android:textSize="10sp"
                        android:textColor="@color/gray_400"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_100"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyOrganik"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Tandai Telah Dikosongkan"
                        android:textColor="@color/emerald_600"
                        android:textStyle="bold"
                        app:backgroundTint="@color/emerald_50"
                        app:elevation="0dp"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Non Organik -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">
                        
                        <ImageView
                            android:id="@+id/icNonOrganik"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            android:background="@drawable/badge_blue_bg"
                            app:tint="@color/secondary"
                            android:padding="12dp"
                            android:layout_centerVertical="true"
                            android:contentDescription="Non-Organik" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toEndOf="@id/icNonOrganik"
                            android:layout_marginStart="16dp"
                            android:layout_centerVertical="true">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Non-Organik"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:textColor="@color/gray_800" />
                            <TextView
                                android:id="@+id/tvNonOrganikUpdate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Update 2 min lalu"
                                android:textSize="10sp"
                                android:textColor="@color/gray_400"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvNonOrganikBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HAMPIR PENUH"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/amber_600"
                            android:background="@drawable/badge_amber_bg"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>

                    <!-- Progress Bar -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tingkat Kapasitas"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/gray_500" />
                        <TextView
                            android:id="@+id/tvNonOrganikPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="85%"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="@color/gray_800"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                    <ProgressBar
                        android:id="@+id/progressNonOrganik"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:progress="85"
                        android:progressDrawable="@drawable/progress_bar_amber"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvNonOrganikStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Segera dikosongkan"
                        android:textAlignment="viewEnd"
                        android:textSize="10sp"
                        android:textColor="@color/amber_600"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_100"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyNonOrganik"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Tandai Telah Dikosongkan"
                        android:textColor="@color/secondary"
                        android:textStyle="bold"
                        app:backgroundTint="@color/blue_50"
                        app:elevation="0dp"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
