<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_50">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin_24"
        android:paddingTop="@dimen/margin_56"
        android:paddingBottom="@dimen/margin_16"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notifikasi"
                android:textStyle="bold"
                android:textSize="@dimen/text_24"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/tvNotifSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peringatan status tong sampah"
                android:textSize="@dimen/text_13"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="@dimen/margin_4" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvClearAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hapus Semua"
            android:textSize="@dimen/text_13"
            android:textStyle="bold"
            android:textColor="@color/red_500"
            android:paddingVertical="@dimen/margin_8"
            android:paddingStart="@dimen/margin_16"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Notification List -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            
            <LinearLayout
                android:id="@+id/notifListContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margin_16"
                android:paddingBottom="@dimen/margin_24" />
                
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/margin_50"/>
                
            <TextView
                android:id="@+id/tvError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/margin_50"
                android:text="Gagal memuat data\nPeriksa koneksi Anda"
                android:gravity="center"
                android:visibility="gone"
                android:textColor="@color/text_secondary" />
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
