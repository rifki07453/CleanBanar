<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".features.dashboard.AdminDashboardFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/margin_24">

        <!-- Header Gradient Block -->
        <FrameLayout
            android:id="@+id/headerBlock"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_250"
            android:background="@drawable/bg_petugas_header"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvOverviewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OVERVIEW SISTEM"
            android:textColor="#A7F3D0" 
            android:textSize="@dimen/text_10"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/margin_24"
            android:layout_marginTop="@dimen/margin_56"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAdminTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Panel"
            android:textColor="@color/white"
            android:textSize="@dimen/text_24"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvOverviewTitle"
            app:layout_constraintTop_toBottomOf="@id/tvOverviewTitle" />

        <!-- Logo top right transparent -->
        <FrameLayout
            android:layout_width="@dimen/margin_60"
            android:layout_height="@dimen/margin_60"
            android:layout_marginTop="@dimen/margin_48"
            android:layout_marginEnd="@dimen/margin_24"
            android:background="@drawable/bg_rounded_light_green_glass"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <!-- App Icon -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo"
                android:padding="@dimen/margin_8" />
        </FrameLayout>

        <!-- Total Petugas -->
        <TextView
            android:id="@+id/tvTotalPetugasLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Petugas Aktif"
            android:textColor="#D1FAE5"
            android:textSize="@dimen/text_12"
            android:layout_marginTop="@dimen/margin_24"
            app:layout_constraintStart_toStartOf="@id/tvOverviewTitle"
            app:layout_constraintTop_toBottomOf="@id/tvAdminTitle" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true"
            app:layout_constraintStart_toStartOf="@id/tvOverviewTitle"
            app:layout_constraintTop_toBottomOf="@id/tvTotalPetugasLabel">

            <TextView
                android:id="@+id/tvTotalPetugasCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="@dimen/text_36"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" orang"
                android:textColor="@color/white"
                android:textSize="@dimen/text_14"
                android:layout_marginStart="@dimen/margin_4" />
        </LinearLayout>

        <!-- Content Container (Overlap Header) -->
        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/margin_minus_40"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/margin_24"
            app:layout_constraintTop_toBottomOf="@id/headerBlock">

            <!-- Row 1: 2 Cards (Manajemen Petugas & Status Perangkat) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/margin_20"
                android:weightSum="2"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/margin_8">

                <!-- Card 1: Manajemen Petugas -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardManajemenPetugas"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_160"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/margin_8"
                    app:cardCornerRadius="@dimen/margin_24"
                    app:cardElevation="@dimen/margin_2"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/margin_16">

                        <FrameLayout
                            android:layout_width="@dimen/margin_48"
                            android:layout_height="@dimen/margin_48"
                            android:background="@drawable/bg_rounded_light_blue"
                            android:layout_marginBottom="@dimen/margin_12">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_users_group_modern"
                                android:padding="@dimen/margin_12" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Manajemen\nPetugas"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_14"
                            android:textStyle="bold"
                            android:textAlignment="center" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tambah/hapus akun"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/text_10"
                            android:textAlignment="center"
                            android:layout_marginTop="@dimen/margin_4" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Status Perangkat -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStatusPerangkat"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_160"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_8"
                    app:cardCornerRadius="@dimen/margin_24"
                    app:cardElevation="@dimen/margin_2"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/margin_16">

                        <FrameLayout
                            android:layout_width="@dimen/margin_48"
                            android:layout_height="@dimen/margin_48"
                            android:background="@drawable/bg_rounded_light_blue"
                            android:backgroundTint="#ECFDF5"
                            android:layout_marginBottom="@dimen/margin_12">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_iot_device_modern"
                                android:padding="@dimen/margin_12" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Manajemen\nPerangkat"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_14"
                            android:textStyle="bold"
                            android:textAlignment="center" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_badge_green"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="@dimen/margin_8"
                            android:paddingVertical="@dimen/margin_4"
                            android:layout_marginTop="@dimen/margin_6">
                            
                            <View
                                android:id="@+id/dotStatus"
                                android:layout_width="@dimen/margin_6"
                                android:layout_height="@dimen/margin_6"
                                android:layout_marginEnd="@dimen/margin_4"
                                android:background="@drawable/dot_timeline_green" />
                                
                            <TextView
                                android:id="@+id/tvDeviceStatusOverview"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ONLINE"
                                android:textColor="#059669"
                                android:textSize="@dimen/text_9"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>


            <!-- Row 2: Aktivitas Terbaru Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_20"
                android:layout_marginTop="@dimen/margin_16"
                app:cardCornerRadius="@dimen/margin_24"
                app:cardElevation="@dimen/margin_1"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_20">

                    <!-- Header List -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_16">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aktivitas Terbaru"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_14"
                            android:textStyle="bold"
                            android:layout_centerVertical="true" />


                    </RelativeLayout>

                    <!-- List Items Container -->
                    <LinearLayout
                        android:id="@+id/recentActivityContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Empty State Vector -->
                    <ImageView
                        android:id="@+id/lottieEmptyState"
                        android:layout_width="@dimen/margin_120"
                        android:layout_height="@dimen/margin_120"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_trash_modern"
                        android:alpha="0.25"
                        app:tint="@color/text_tertiary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvEmptyStateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Belum ada aktivitas"
                        android:textColor="@color/text_tertiary"
                        android:textSize="@dimen/text_12"
                        android:visibility="gone"
                        android:layout_marginTop="@dimen/margin_8" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
