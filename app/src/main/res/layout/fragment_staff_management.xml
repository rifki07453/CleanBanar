<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F6"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/margin_24"
        android:gravity="center_vertical">
        
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/margin_36"
            android:layout_height="@dimen/margin_36"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_rounded_light_green_glass"
            android:backgroundTint="#ECFDF5"
            android:padding="@dimen/margin_8"
            android:clickable="true"
            android:focusable="true"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manajemen Petugas"
            android:textStyle="bold"
            android:textSize="@dimen/text_20"
            android:layout_marginStart="@dimen/margin_16"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_24"
            android:paddingBottom="@dimen/margin_40">

            <!-- Form Pendaftaran -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/margin_24"
                app:cardElevation="@dimen/margin_2"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_20">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tambah Akun Baru"
                        android:textSize="@dimen/text_14"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/margin_16"/>


                    <EditText
                        android:id="@+id/etNewName"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_50"
                        android:background="@drawable/edit_text_bg"
                        android:hint="Nama Lengkap"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/margin_16"
                        android:textSize="@dimen/text_14"
                        android:textColorHint="@color/text_tertiary"
                        android:layout_marginBottom="@dimen/margin_12" />

                    <EditText
                        android:id="@+id/etNewEmail"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_50"
                        android:background="@drawable/edit_text_bg"
                        android:hint="Email Akses"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="@dimen/margin_16"
                        android:textSize="@dimen/text_14"
                        android:textColorHint="@color/text_tertiary"
                        android:layout_marginBottom="@dimen/margin_12" />

                    <EditText
                        android:id="@+id/etNewPhone"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_50"
                        android:background="@drawable/edit_text_bg"
                        android:hint="Nomor HP / WhatsApp (Opsional)"
                        android:inputType="phone"
                        android:paddingHorizontal="@dimen/margin_16"
                        android:textSize="@dimen/text_14"
                        android:textColorHint="@color/text_tertiary"
                        android:layout_marginBottom="@dimen/margin_12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERAN PENGGUNA (ROLE)"
                        android:textSize="@dimen/text_10"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="@dimen/margin_6" />

                    <RadioGroup
                        android:id="@+id/rgRole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/margin_12">

                        <RadioButton
                            android:id="@+id/rbPetugas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Petugas"
                            android:checked="true"
                            android:textColor="@color/text_primary"
                            android:layout_marginEnd="@dimen/margin_24" />

                        <RadioButton
                            android:id="@+id/rbAdmin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Admin"
                            android:textColor="@color/text_primary" />
                    </RadioGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/text_tertiary"
                        app:boxBackgroundMode="none"
                        android:layout_marginBottom="@dimen/margin_16">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/margin_50"
                            android:background="@drawable/edit_text_bg"
                            android:hint="Password Sistem"
                            android:inputType="textPassword"
                            android:paddingHorizontal="@dimen/margin_16"
                            android:textSize="@dimen/text_14"
                            android:textColorHint="@color/text_tertiary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Using #059669 for Green instead of Indigo to match Admin preview style -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateAccount"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_50"
                        android:text="Buat Akun Baru"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_14"
                        android:textStyle="bold"
                        app:backgroundTint="#059669" 
                        app:cornerRadius="@dimen/margin_12" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- List Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAFTAR AKUN (ADMIN &amp; PETUGAS)"
                android:textStyle="bold"
                android:textSize="@dimen/text_10"
                android:textColor="@color/text_secondary"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_32"
                android:layout_marginBottom="@dimen/margin_16" />


            <!-- Filters -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/margin_16"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semua"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdmin"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin saja" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPetugas"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Petugas saja" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Staff List -->
            <LinearLayout
                android:id="@+id/staffListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/margin_32"
                android:visibility="gone">
                
                <ImageView
                    android:layout_width="@dimen/margin_100"
                    android:layout_height="@dimen/margin_100"
                    android:src="@drawable/ic_profile"
                    android:alpha="0.25"
                    app:tint="@color/text_tertiary" />
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum ada petugas terdaftar"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_14"
                    android:layout_marginTop="@dimen/margin_16" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
