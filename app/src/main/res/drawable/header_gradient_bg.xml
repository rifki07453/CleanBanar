<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base diagonal gradient: light green to dark green -->
    <item>
        <shape>
            <gradient
                android:startColor="@color/emerald_400"
                android:centerColor="@color/emerald_600"
                android:endColor="@color/emerald_800"
                android:type="linear"
                android:angle="135"/>
            <corners
                android:bottomLeftRadius="32dp"
                android:bottomRightRadius="32dp"/>
        </shape>
    </item>
    <!-- Radial highlight overlay on top-right -->
    <item>
        <shape>
            <gradient
                android:startColor="#554dffb3"
                android:endColor="#00000000"
                android:type="radial"
                android:gradientRadius="220dp"
                android:centerX="85%"
                android:centerY="15%"/>
            <corners
                android:bottomLeftRadius="32dp"
                android:bottomRightRadius="32dp"/>
        </shape>
    </item>
</layer-list>
